{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions for all Squelch windows",
  "windows": [
    "*"
  ],
  "permissions": [
    "core:default",
    "notification:default",
    "positioner:default",
    "global-shortcut:default"
  ]
}
