{
    "name": "squelch",
    "productName": "Squelch",
    "version": "0.1.1",
    "description": "Lightweight cross-platform menu bar internet radio player (macOS first, powered by Tauri)",
    "homepage": "https://github.com/mrbvrz/squelch",
    "repository": {
        "type": "git",
        "url": "https://github.com/mrbvrz/squelch.git"
    },
    "author": "mrbvrz (https://github.com/mrbvrz)",
    "license": "MIT",
    "scripts": {
        "dev": "tauri dev",
        "dev:ui": "vite",
        "tauri": "tauri",
        "tauri:dev": "tauri dev",
        "build": "npm run build:ui",
        "build:ui": "vite build",
        "tauri:build": "npm run build:ui && tauri build --bundles app",
        "tauri:dist": "npm run build:ui && tauri build --bundles app && cd src-tauri/target/release/bundle/macos && codesign --force --deep --sign - Squelch.app && hdiutil create -volname Squelch -srcfolder Squelch.app -ov -format UDZO Squelch-0.1.1-arm64.dmg && zip -r -9 Squelch-0.1.1-arm64.zip Squelch.app",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\"",
        "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.{json,md,html}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.{json,md,html}\"",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@heroicons/react": "^2.2.0",
        "@tauri-apps/api": "^2.12.4",
        "@tauri-apps/plugin-global-shortcut": "^2.4.1",
        "hls.js": "^1.5.17"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2.12.4",
        "@types/node": "^22.9.0",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@typescript-eslint/eslint-plugin": "^8.15.0",
        "@typescript-eslint/parser": "^8.15.0",
        "@vitejs/plugin-react": "^4.3.3",
        "autoprefixer": "^10.4.20",
        "eslint": "^9.15.0",
        "postcss": "^8.4.49",
        "prettier": "^3.9.10",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "tailwindcss": "^3.4.15",
        "tsx": "^4.19.2",
        "typescript": "^5.6.3",
        "vite": "^5.4.11",
        "vitest": "^2.1.5"
    }
}
