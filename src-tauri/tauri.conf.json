{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Squelch",
  "version": "0.1.3",
  "identifier": "com.mrbvrz.squelch",
  "build": {
    "frontendDist": "../dist-ui",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:ui",
    "beforeBuildCommand": "npm run build:ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Squelch",
        "url": "index.html",
        "width": 980,
        "height": 680,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "transparent": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 18
        }
      },
      {
        "label": "tray",
        "title": "Squelch Tray",
        "url": "tray.html",
        "width": 360,
        "height": 520,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "shadow": true
      },
      {
        "label": "audio",
        "title": "Squelch Audio Worker",
        "url": "audio.html",
        "width": 200,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
