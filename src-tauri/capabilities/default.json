{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions for all Squelch windows",
  "windows": [
    "*"
  ],
    "permissions": [
        "core:default",
        "core:window:allow-start-dragging",
        "notification:default",
        "positioner:default",
        "global-shortcut:default"
    ]
}
